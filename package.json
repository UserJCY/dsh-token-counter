{
  "name": "dsh-token-split",
  "version": "0.3.3",
  "type": "module",
  "description": "Per-machine OpenCode Go token accounting with Go pricing, allowance percentages, a sidebar panel and a detailed usage dialog for DSH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UserJCY/dsh-token-counter.git"
  },
  "homepage": "https://github.com/UserJCY/dsh-token-counter#readme",
  "bugs": {
    "url": "https://github.com/UserJCY/dsh-token-counter/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tokens",
    "usage",
    "opencode-go"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --import ./test/register.mjs test/run.mjs"
  },
  "devDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "license": "MIT"
}
